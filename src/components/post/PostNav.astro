---
import { currentLocale, getT } from "@/i18n";
import { buildPostFallbackCoverUrl } from "@/toolkit/posts/fallbackCover";
import { generateRandomBrightColor } from "@/toolkit/tools/generateRandomBrightColor";

interface NavPost {
  title: string;
  slug: string;
  category?: string;
  cover?: string;
}

interface Props {
  prevPost?: NavPost;
  nextPost?: NavPost;
  nextGradientCover?: boolean;
  fallbackCoverUrl?: string;
}

const {
  prevPost,
  nextPost,
  nextGradientCover = false,
  fallbackCoverUrl,
} = Astro.props;
const t = getT(currentLocale);

function getPostNavBackground(post: NavPost): string | undefined {
  if (nextGradientCover) {
    return `background-image: linear-gradient(to bottom right, ${generateRandomBrightColor()}, ${generateRandomBrightColor()});`;
  }

  const cover = post.cover ?? buildPostFallbackCoverUrl(fallbackCoverUrl, post.slug);
  return cover ? `background-image: url(${JSON.stringify(cover)});` : undefined;
}
---

<div class="post-nav">
  <div class="item left">
    {
      prevPost && (
        <a
          href={`/posts/${prevPost.slug}/`}
          itemprop="url"
          rel="prev"
          title={prevPost.title}
          style={getPostNavBackground(prevPost)}
        >
          <span class="type">{t("post.previousPost")}</span>
          {prevPost.category && (
            <span class="category">
              <i class="ic i-ri-flag-line" />
              {prevPost.category}
            </span>
          )}
          <span class="post-nav-title">{prevPost.title}</span>
        </a>
      )
    }
  </div>

  <div class="item right">
    {
      nextPost && (
        <a
          href={`/posts/${nextPost.slug}/`}
          itemprop="url"
          rel="next"
          title={nextPost.title}
          style={getPostNavBackground(nextPost)}
        >
          <span class="type">{t("post.nextPost")}</span>
          {nextPost.category && (
            <span class="category">
              <i class="ic i-ri-flag-line" />
              {nextPost.category}
            </span>
          )}
          <span class="post-nav-title">{nextPost.title}</span>
        </a>
      )
    }
  </div>
</div>
